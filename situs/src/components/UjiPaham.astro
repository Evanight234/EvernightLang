---
// Section "Uji Pemahaman": kuis pilihan ganda per tahap tutorial (data src/data/quis.ts).
import { kuis } from '../data/quis';

interface Props {
  slug: string; // "01-halo-dunia"
}
const { slug } = Astro.props;
const data = kuis[slug];
const soal = data?.soal ?? [];
---

{soal.length > 0 && (
  <section id="uji-pemahaman" class="mt-8 rounded-[10px] border border-[#7F77DD]/40 bg-[#FCF8FF] overflow-hidden">
    <header class="flex items-start justify-between gap-3 px-5 pt-5">
      <div>
        <h2 class="text-lg font-bold text-[#1C1B22]" data-en="Test Your Understanding">Uji Pemahaman</h2>
        <p class="text-[13px] text-[#6B6880]" data-en="3-5 quick questions for this stage">3-5 pertanyaan singkat untuk tahap ini</p>
      </div>
      <span id="kuis-progres" class="shrink-0 rounded-full bg-[#7F77DD]/15 px-3 py-1 text-xs font-bold text-[#534AB7]">Soal 1 dari {soal.length}</span>
    </header>

    <div class="px-5 py-4">
      <p id="kuis-tanya" class="text-[15px] font-bold text-[#1C1B22] leading-relaxed"></p>

      <div id="kuis-pilihan" class="mt-4 space-y-2.5"></div>

      <p id="kuis-umpan" class="mt-3 text-sm font-medium hidden"></p>

      <button id="kuis-kirim" type="button" class="mt-4 rounded-[10px] bg-[#7F77DD] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#534AB7] transition-colors">
        Kirim Jawaban »
      </button>
    </div>
  </section>
)}

<script define:vars={{ soal }}>
  const T = {
    id: {
      progres: (a, n) => 'Soal ' + a + ' dari ' + n,
      kirim: 'Kirim Jawaban »',
      berikut: 'Soal Berikutnya »',
      lihat: 'Lihat Hasil »',
      pilihDulu: 'Pilih salah satu jawaban dulu.',
      benar: 'Benar!',
      salah: 'Belum tepat. Jawaban benar ditandai hijau.',
      selesai: (s, n) => 'Selesai! Skor kamu: ' + s + ' dari ' + n + '.',
      jumlahBenar: (s, n) => s + ' / ' + n + ' benar',
      ulangiKuis: 'Ulangi kuis untuk memperbaiki skor.',
      ulangi: 'Ulangi',
    },
    en: {
      progres: (a, n) => 'Question ' + a + ' of ' + n,
      kirim: 'Submit Answer »',
      berikut: 'Next Question »',
      lihat: 'See Result »',
      pilihDulu: 'Pick one answer first.',
      benar: 'Correct!',
      salah: 'Not quite. The right answer is marked green.',
      selesai: (s, n) => 'Done! Your score: ' + s + ' of ' + n + '.',
      jumlahBenar: (s, n) => s + ' / ' + n + ' correct',
      ulangiKuis: 'Retake the quiz to improve your score.',
      ulangi: 'Retry',
    },
  };
  const bahasa = () => (localStorage.getItem('evernight_lang') === 'en' ? 'en' : 'id');
  const t = () => T[bahasa()];
  const teksSoal = (s) => (bahasa() === 'en' && s.tanyaEn ? s.tanyaEn : s.tanya);
  const teksPilihan = (s) => (bahasa() === 'en' && s.pilihanEn ? s.pilihanEn : s.pilihan);

  const tanya = document.getElementById('kuis-tanya');
  const kotakPilihan = document.getElementById('kuis-pilihan');
  const progres = document.getElementById('kuis-progres');
  const umpan = document.getElementById('kuis-umpan');
  const kirim = document.getElementById('kuis-kirim');
  if (tanya && kotakPilihan && progres && umpan && kirim) {
    let i = 0;
    let skor = 0;
    let dinilai = false;
    let umpanJenis = '';

    function gambar() {
      const s = soal[i];
      progres.textContent = t().progres(i + 1, soal.length);
      tanya.textContent = teksSoal(s);
      kotakPilihan.innerHTML = '';
      teksPilihan(s).forEach((teks, idx) => {
        const label = document.createElement('label');
        label.className =
          'flex items-center gap-3 rounded-lg border border-[#E6E2F5] bg-white px-4 py-2.5 text-sm text-[#26262E] cursor-pointer hover:border-[#7F77DD]/60 transition-colors';
        label.innerHTML =
          '<input type="radio" name="kuis" class="accent-[#7F77DD] w-4 h-4 shrink-0" value="' +
          idx +
          '"><span>' +
          teks.replace(/&/g, '&amp;').replace(/</g, '&lt;') +
          '</span>';
        kotakPilihan.appendChild(label);
      });
      umpan.classList.add('hidden');
      umpanJenis = '';
      kirim.textContent = t().kirim;
      dinilai = false;
    }

    function nilai() {
      const radio = kotakPilihan.querySelector('input:checked');
      if (!radio) {
        umpan.textContent = t().pilihDulu;
        umpan.className = 'mt-3 text-sm font-medium text-[#A6522F]';
        umpan.classList.remove('hidden');
        return;
      }
      const pilih = Number(radio.value);
      const benar = soal[i].benar;
      kotakPilihan.querySelectorAll('label').forEach((l, idx) => {
        l.style.pointerEvents = 'none';
        if (idx === benar) {
          l.style.borderColor = '#0F6E56';
          l.style.background = '#F0FAF7';
        } else if (idx === pilih) {
          l.style.borderColor = '#C0392B';
          l.style.background = '#FDF3F2';
        }
      });
      if (pilih === benar) {
        skor += 1;
        umpanJenis = 'benar';
        umpan.className = 'mt-3 text-sm font-medium text-[#0F6E56]';
      } else {
        umpanJenis = 'salah';
        umpan.className = 'mt-3 text-sm font-medium text-[#A6522F]';
      }
      umpan.textContent = t()[umpanJenis];
      umpan.classList.remove('hidden');
      dinilai = true;
      kirim.textContent = i < soal.length - 1 ? t().berikut : t().lihat;
    }

    function selesai() {
      tanya.textContent = t().selesai(skor, soal.length);
      kotakPilihan.innerHTML = '';
      progres.textContent = t().jumlahBenar(skor, soal.length);
      umpan.textContent = t().ulangiKuis;
      umpan.className = 'mt-3 text-sm font-medium text-[#534AB7]';
      umpan.classList.remove('hidden');
      kirim.textContent = t().ulangi;
      dinilai = 'ulang';
    }

    // Ganti bahasa: tukar teks di tempat, status kuis tidak hilang.
    window.addEventListener('evernight-lang', () => {
      const s = soal[i];
      if (dinilai === 'ulang') {
        tanya.textContent = t().selesai(skor, soal.length);
        progres.textContent = t().jumlahBenar(skor, soal.length);
        umpan.textContent = t().ulangiKuis;
        kirim.textContent = t().ulangi;
        return;
      }
      progres.textContent = t().progres(i + 1, soal.length);
      tanya.textContent = teksSoal(s);
      kotakPilihan.querySelectorAll('span').forEach((sp, idx) => {
        sp.textContent = teksPilihan(s)[idx];
      });
      if (umpanJenis) umpan.textContent = t()[umpanJenis];
      kirim.textContent = dinilai === true
        ? i < soal.length - 1
          ? t().berikut
          : t().lihat
        : t().kirim;
    });

    kirim.addEventListener('click', () => {
      if (dinilai === false) {
        nilai();
      } else if (dinilai === true) {
        i += 1;
        if (i < soal.length) gambar();
        else selesai();
      } else {
        i = 0;
        skor = 0;
        gambar();
      }
    });

    gambar();
  }
</script>
