---
// Section "Coba Kamu Run": editor yang terlihat bisa diedit + tombol run + panel output.
// Eksekusi masih simulasi — pengganti aslinya menyusul (evernight_wasm).
interface Props {
  body: string;
}
const { body } = Astro.props;

const KATA = [
  'lainnya_jika', 'fungsi', 'kembali', 'variabel', 'selama', 'untuk', 'dari', 'sampai',
  'dalam', 'coba', 'tangkap', 'lempar', 'pastikan', 'impor', 'sebagai', 'cocok', 'kasus',
  'berhenti', 'lanjut', 'jika', 'lainnya', 'dan', 'atau', 'bukan', 'benar', 'salah',
  'kosong', 'kelas', 'guna',
];

function esk(t: string): string {
  return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function sorotBaris(baris: string): string {
  const esc = esk(baris);
  if (esc.trimStart().startsWith('#')) return `<span class="tok-c">${esc}</span>`;

  const strings: string[] = [];
  let out = esc.replace(/"[^"]*"/g, (m) => {
    strings.push(m);
    return '\u0000' + 'x'.repeat(strings.length) + '\u0000';
  });
  out = out.replace(/(^|[^\s(,])(\d+(?:\.\d+)?)(?![\w.])/g, (_m, p, n) => `${p}<span class="tok-n">${n}</span>`);
  out = out.replace(new RegExp(`\\b(${KATA.join('|')})\\b`, 'g'), '<span class="tok-k">$1</span>');
  out = out.replace(/([A-Za-z_]\w*)\s*\(/g, '<span class="tok-f">$1</span>(');
  out = out.replace(/\u0000x*\u0000/g, () => strings.shift() ?? '');
  return out;
}

function sorot(teks: string): string {
  return teks.split('\n').map(sorotBaris).join('\n');
}

function blok(src: string, setelah?: string, lang?: string): string | null {
  let s = src;
  if (setelah) {
    const i = s.indexOf(setelah);
    if (i >= 0) s = s.slice(i);
  }
  const re = /```([a-zA-Z]*)\n([\s\S]*?)```/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s))) {
    if (lang === undefined || m[1].toLowerCase() === lang) return m[2].replace(/\n+$/, '');
  }
  return null;
}

const kode =
  blok(body, '## Contoh lengkap', 'eve') ??
  blok(body, undefined, 'eve') ??
  '# tulis kode di sini\ncetak("Halo Dunia")';

const keluaran =
  blok(body, 'Output yang diharapkan', '') ??
  blok(body, 'Output yang diharapkan') ??
  '(jalankan untuk melihat hasil)';

const contohSorot = sorot(kode);
---

<section id="coba-kamu-run" class="mt-8 rounded-[10px] border border-[#E6E2F5] bg-white overflow-hidden">
  <header class="flex items-center justify-between border-b border-[#EBEAF1] px-4 py-3">
    <span class="text-sm font-bold text-[#1C1B22]">Coba Kamu Run</span>
    <span class="rounded-full bg-[#0F6E56] px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Live</span>
  </header>

  <div class="p-4">
    <div class="relative">
      <pre
        id="editor-coba"
        contenteditable="true"
        spellcheck="false"
        class="min-h-[11rem] max-h-80 overflow-auto rounded-[10px] border-2 border-[#3A3A52] bg-[#17151E] p-4 text-[13px] leading-[1.65] text-[#E6E6F2] outline-none focus:border-[#7F77DD]"
        style="font-family: var(--font-mono);"><code set:html={contohSorot}></code><span class="kursor-tipis" contenteditable="false"></span></pre>
    </div>

    <button
      id="tombol-coba"
      type="button"
      class="mt-3 rounded-[10px] bg-[#7F77DD] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#534AB7] transition-colors"
    >Coba Kamu Run ▶</button>

    <div id="keluaran-coba" class="mt-3 rounded-[10px] bg-[#0A0A0C] p-4 font-mono text-[13px] leading-relaxed" style="font-family: var(--font-mono);">
      <div class="text-[#9CA3AF]">$ evernight main.eve</div>
      <div class="text-[#28C840] whitespace-pre-wrap">{keluaran}</div>
    </div>
  </div>
</section>

<style is:global>
  .kursor-tipis {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    background: #c9b8ff;
    vertical-align: text-bottom;
    animation: kedip 1.1s steps(1) infinite;
  }
  @keyframes kedip {
    50% { opacity: 0; }
  }
  #editor-coba:focus .kursor-tipis {
    display: none;
  }
  #editor-coba .tok-f { color: #ed93b1; }
</style>

<script>
  const tombol = document.getElementById('tombol-coba');
  const panel = document.getElementById('keluaran-coba');
  tombol?.addEventListener('click', () => {
    tombol.setAttribute('disabled', '');
    tombol.textContent = 'Menjalankan…';
    setTimeout(() => {
      if (panel) {
        panel.style.transition = 'border-color 0.2s';
        panel.style.border = '2px solid #0F6E56';
        setTimeout(() => (panel.style.border = ''), 700);
      }
      tombol.removeAttribute('disabled');
      tombol.textContent = 'Coba Kamu Run ▶';
    }, 450);
  });
</script>
