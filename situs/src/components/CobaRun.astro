---
// Section "Coba Kamu Run": editor teks aktif (overlay textarea) + highlight dinamis
// + tombol reset + run yang mengeksekusi teks terkini (mini-interpreter, lihat eve-run.mjs).
import { sorot } from '../lib/eve-run.mjs';

interface Props {
  body: string;
}
const { body } = Astro.props;

function blok(src: string, setelah?: string, lang?: string): string | null {
  let s = src;
  if (setelah) {
    const i = s.indexOf(setelah);
    if (i >= 0) s = s.slice(i);
  }
  const re = /```([a-zA-Z]*)\n([\s\S]*?)```/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s))) {
    if (lang === undefined || m[1].toLowerCase() === lang) return m[2].replace(/\n+$/, '');
  }
  return null;
}

const kode =
  blok(body, '## Contoh lengkap', 'eve') ??
  blok(body, undefined, 'eve') ??
  '# tulis kode di sini\ncetak("Halo Dunia")';

const keluaran =
  blok(body, 'Output yang diharapkan', '') ??
  blok(body, 'Output yang diharapkan') ??
  '(jalankan untuk melihat hasil)';

const contohSorot = sorot(kode);
---

<section id="coba-kamu-run" class="mt-8 rounded-[10px] border border-[#E6E2F5] bg-white overflow-hidden">
  <header class="flex items-center justify-between border-b border-[#EBEAF1] px-4 py-3">
    <span class="text-sm font-bold text-[#1C1B22]">Coba Kamu Run</span>
    <span class="rounded-full bg-[#0F6E56] px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Live</span>
  </header>

  <div class="p-4">
    <div
      class="relative rounded-[10px] border-2 border-[#3A3A52] bg-[#17151E] transition-colors focus-within:border-[#7F77DD]"
    >
      <button
        id="reset-coba"
        type="button"
        title="Kembalikan ke kode awal"
        aria-label="Kembalikan ke kode awal"
        class="absolute right-2 top-2 z-20 rounded-md border border-white/15 bg-[#17151E]/90 p-1.5 text-[#9CA3AF] hover:text-white transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-3-6.7"></path>
          <polyline points="21 3 21 9 15 9"></polyline>
        </svg>
      </button>

      <!-- lapisan highlight (di belakang, tidak menerima pointer) -->
      <pre
        id="highlight-coba"
        aria-hidden="true"
        class="pointer-events-none m-0 min-h-[11rem] max-h-80 overflow-auto p-4 pr-10 text-[13px] leading-[1.65] text-[#E6E6F2]"
        style="font-family: var(--font-mono);"><code set:html={contohSorot}></code></pre>

      <!-- input teks aktif (di atas, teks transparan, kursor native terlihat) -->
      <textarea
        id="editor-coba"
        spellcheck="false"
        wrap="off"
        aria-label="Kode Evernight yang bisa diedit"
        class="absolute inset-0 z-10 m-0 h-full w-full resize-none overflow-auto border-0 bg-transparent p-4 pr-10 text-[13px] leading-[1.65] text-transparent caret-[#C9B8FF] outline-none"
        style="font-family: var(--font-mono);">{kode}</textarea>

      <!-- kursor berkedip halus saat belum difokuskan -->
      <span class="kursor-tipis" aria-hidden="true"></span>
    </div>

    <button
      id="tombol-coba"
      type="button"
      class="mt-3 rounded-[10px] bg-[#7F77DD] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#534AB7] transition-colors"
    >Coba Kamu Run ▶</button>

    <div
      id="keluaran-coba"
      class="mt-3 rounded-[10px] bg-[#0A0A0C] p-4 font-mono text-[13px] leading-relaxed"
      style="font-family: var(--font-mono);"
    >
      <div class="text-[#9CA3AF]">$ evernight main.eve</div>
      <div id="stdout-coba" class="text-[#28C840] whitespace-pre-wrap">{keluaran}</div>
    </div>
  </div>
</section>

<style is:global>
  #editor-coba {
    scrollbar-width: none;
  }
  #editor-coba::-webkit-scrollbar {
    display: none;
  }
  .kursor-tipis {
    position: absolute;
    left: 18px;
    top: 21px;
    z-index: 5;
    display: inline-block;
    width: 2px;
    height: 1.1em;
    background: #c9b8ff;
    animation: kedip 1.1s steps(1) infinite;
    pointer-events: none;
  }
  #coba-kamu-run:focus-within .kursor-tipis {
    display: none;
  }
  @keyframes kedip {
    50% { opacity: 0; }
  }
</style>

<script>
  import { sorot, jalankan } from '../lib/eve-run.mjs';

  const ta = document.getElementById('editor-coba') as HTMLTextAreaElement | null;
  const pre = document.getElementById('highlight-coba');
  const tombol = document.getElementById('tombol-coba');
  const reset = document.getElementById('reset-coba');
  const stdout = document.getElementById('stdout-coba');

  if (ta && pre && tombol && stdout) {
    const kodeAwal = ta.value;
    const keluaranAwal = stdout.textContent ?? '';

    const render = (baris: string[]) => {
      stdout.textContent = '';
      if (baris.length === 0) {
        const d = document.createElement('div');
        d.textContent = '(tidak ada keluaran)';
        d.className = 'text-[#6B7280]';
        stdout.appendChild(d);
        return;
      }
      for (const b of baris) {
        const d = document.createElement('div');
        d.textContent = b;
        d.className = b.startsWith('BAHAYA:') ? 'text-[#FF5F57]' : 'text-[#28C840]';
        stdout.appendChild(d);
      }
    };

    ta.addEventListener('input', () => {
      pre.innerHTML = sorot(ta.value);
    });
    ta.addEventListener('scroll', () => {
      pre.scrollTop = ta.scrollTop;
      pre.scrollLeft = ta.scrollLeft;
    });

    reset.addEventListener('click', () => {
      ta.value = kodeAwal;
      pre.innerHTML = sorot(kodeAwal);
      render(keluaranAwal.split('\n'));
      ta.focus();
    });

    tombol.addEventListener('click', () => {
      const hasil = jalankan(ta.value);
      render(hasil.baris);
      const panel = document.getElementById('keluaran-coba');
      if (panel) {
        panel.style.transition = 'border-color 0.2s';
        panel.style.border = '2px solid #0F6E56';
        setTimeout(() => (panel.style.border = ''), 700);
      }
    });
  }
</script>
