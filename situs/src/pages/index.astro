---
import Base from '../layouts/Base.astro';

const slides = [1, 2, 3, 4, 5];

const kodeContoh = [
  '<span class="tok-c"># Program Faktorial EvernightLanguage</span>',
  '<span class="tok-k">fungsi</span> <span class="tok-f">faktorial</span>(n) {',
  '    <span class="tok-k">jika</span> n <span class="tok-o">&lt;=</span> <span class="tok-n">1</span> {',
  '        <span class="tok-k">kembali</span> <span class="tok-n">1</span>',
  '    } <span class="tok-k">lainnya</span> {',
  '        <span class="tok-k">kembali</span> n <span class="tok-o">*</span> <span class="tok-f">faktorial</span>(n <span class="tok-o">-</span> <span class="tok-n">1</span>)',
  '    }',
  '}',
  '',
  '<span class="tok-k">variabel</span> angka = <span class="tok-n">5</span>',
  '<span class="tok-k">variabel</span> hasil = <span class="tok-f">faktorial</span>(angka)',
  '<span class="tok-f">cetak</span>(<span class="tok-s">"Faktorial:"</span>, hasil)',
].join('\n');
---

<Base aktif="beranda" tema="gelap">
  <!-- ===== Hero ===== -->
  <section class="relative overflow-hidden min-h-[calc(100vh-3.5rem-4.5rem)] flex items-center">
    <!-- Latar -->
    <div class="absolute inset-0 bg-[url('/assets/hero.jpg')] bg-cover bg-center" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0F0F14]/95 via-[#0F0F14]/80 to-[#0F0F14]/55" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#15151B] via-transparent to-[#15151B]/40" aria-hidden="true"></div>

    <div class="relative w-full max-w-7xl mx-auto px-5 md:px-8 py-14 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Editor kode (beku) -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class="rounded-2xl bg-[#1A1A22]/90 backdrop-blur-md border border-white/10 shadow-[0_24px_60px_rgba(0,0,0,0.5)] overflow-hidden">
          <div class="flex items-center gap-3 h-11 px-4 bg-white/[0.04] border-b border-white/10">
            <span class="flex gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
            </span>
            <span class="flex items-center gap-2 h-7 px-3 rounded-md bg-white/[0.07] border border-white/10 text-xs font-medium text-[#C9B8FF]" style="font-family: var(--font-mono);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
              main.eve
            </span>
          </div>
          <pre class="p-5 md:p-6 overflow-x-auto text-[13px] md:text-[13.5px] leading-[1.7]" style="font-family: var(--font-mono);"><code set:html={kodeContoh}></code></pre>
        </div>
        <p class="mt-4 text-sm text-[#9CA3AF] font-mono">$ evernight main.eve → <span class="text-[#28C840]">Faktorial: 120</span></p>
      </div>

      <!-- Headline + pagination -->
      <div class="lg:col-span-5 order-1 lg:order-2">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#7F77DD]/40 bg-[#7F77DD]/10 px-3.5 py-1.5 text-xs font-medium text-[#C9B8FF]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C9B8FF]"></span>
          v0.1.0 · Windows x64
        </div>

        <div class="min-h-[13.5rem] sm:min-h-[12rem]">
          {slides.map((i) => (
            <div class="slide-item" data-slide={i} hidden={i !== 1}>
              <h1 class="text-3xl md:text-[2.6rem] leading-[1.12] font-extrabold tracking-tight text-white" data-i18n={`hero.s${i}_judul`}>
                Keamanan Ekspresif Tanpa Overhead Runtime
              </h1>
              <p class="mt-4 text-[15px] leading-relaxed text-[#B9BAC7]" data-i18n={`hero.s${i}_teks`}>
                Evernight menyatukan keselamatan kompilasi-waktu dengan sintaks ergonomis.
              </p>
            </div>
          ))}
        </div>

        <div class="mt-7 flex items-center gap-2">
          {slides.map((i) => (
            <button
              type="button"
              class="tombol-slide w-8 h-8 rounded-lg text-xs font-semibold transition-all"
              data-slide-tombol={i}
              aria-label={`Slide ${i}`}
              data-aktif={i === 1 ? 'ya' : 'tidak'}
            >
              {i}
            </button>
          ))}
        </div>

        <a
          href="/docs/quickstart"
          class="mt-7 inline-flex items-center gap-2 rounded-lg bg-[#7F77DD] px-5 py-2.5 text-sm font-semibold text-white shadow-[0_0_24px_rgba(127,119,221,0.35)] hover:bg-[#6C64CF] transition-colors"
          data-i18n="hero.coba"
        >Coba dokumentasinya</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .tombol-slide {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
  }
  .tombol-slide:hover { color: #fff; border-color: rgba(201, 184, 255, 0.5); }
  .tombol-slide[data-aktif='ya'] {
    background: #7f77dd;
    border-color: #7f77dd;
    color: #fff;
    box-shadow: 0 0 14px rgba(127, 119, 221, 0.45);
  }
</style>

<script>
  const tombol = document.querySelectorAll<HTMLButtonElement>('[data-slide-tombol]');
  const panel = document.querySelectorAll<HTMLElement>('[data-slide]');

  function tampilkan(n: string) {
    panel.forEach((p) => {
      p.hidden = p.dataset.slide !== n;
    });
    tombol.forEach((t) => {
      t.dataset.aktif = t.dataset.slideTombol === n ? 'ya' : 'tidak';
    });
  }

  tombol.forEach((t) => t.addEventListener('click', () => tampilkan(t.dataset.slideTombol!)));
</script>
