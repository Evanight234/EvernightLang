---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

let versi = '0.1.0';
let sha = '';
try {
  versi = readFileSync(join(process.cwd(), '..', 'version', 'version'), 'utf8').trim();
} catch {}
try {
  sha = readFileSync(join(process.cwd(), '..', 'paket', 'SHA256SUMS.txt'), 'utf8').trim();
} catch {}

const repo = 'https://github.com/Evanight234/EvernightLang/raw/main/paket';
const urlZip = `${repo}/evernight-${versi}-windows-x64.zip`;
const urlSetup = `${repo}/evernight-${versi}-windows-x64/setup/Setup.exe`;

const barisSha = sha
  .split('\n')
  .map((b) => b.trim())
  .filter(Boolean)
  .map((b) => {
    const [hash, nama] = b.split(/\s+/);
    return { hash, nama };
  });
---

<Base judul={`Unduh Evernight v${versi} — EvernightLanguage`} tema="terang" aktif="unduh">
  <section class="bg-[#F1EDFB] border-b border-[#7F77DD]/25">
    <div class="max-w-5xl mx-auto px-5 md:px-8 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-[#1C1B22]" data-i18n="unduh.judul">Unduh Evernight</h1>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 md:px-8 py-12 grid md:grid-cols-2 gap-6">
    <!-- Kartu Cepat -->
    <div class="rounded-2xl border border-[#E6E2F5] bg-white p-7 shadow-sm flex flex-col">
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-[#7F77DD]/12 text-[#7F77DD] flex items-center justify-center font-bold">↓</span>
        <div>
          <h2 class="font-bold text-lg text-[#1C1B22]" data-i18n="unduh.cepat">Cepat</h2>
          <p class="text-[13px] text-[#6B6880]" data-i18n="unduh.cepat_desc">Ekstrak ZIP lalu jalankan install.cmd untuk pasang otomatis.</p>
        </div>
      </div>
      <div class="mt-5 rounded-lg bg-[#15151E] p-4 font-mono text-[12.5px] leading-relaxed text-[#E6E6F2]">
        <div><span class="text-[#6B7280]">1.</span> unduh <span class="text-[#38BDF8]">evernight-{versi}-windows-x64.zip</span></div>
        <div><span class="text-[#6B7280]">2.</span> ekstrak ke <span class="text-[#FBBF24]">C:\Evernight</span></div>
        <div><span class="text-[#6B7280]">3.</span> jalankan <span class="text-[#C9B8FF]">install.cmd</span></div>
      </div>
      <a href={urlZip} class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-[#7F77DD] px-5 py-3 text-sm font-semibold text-white hover:bg-[#6C64CF] transition-colors shadow-[0_0_20px_rgba(127,119,221,0.3)]">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Unduh ZIP (6,7 MB)
      </a>
    </div>

    <!-- Kartu Wizard -->
    <div class="rounded-2xl border border-[#7F77DD]/40 bg-[#FCF8FF] p-7 shadow-sm flex flex-col relative overflow-hidden">
      <span class="absolute top-4 right-4 rounded-full bg-[#7F77DD] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">Direkomendasikan</span>
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-[#7F77DD]/15 text-[#7F77DD] flex items-center justify-center font-bold">⚙</span>
        <div>
          <h2 class="font-bold text-lg text-[#1C1B22]" data-i18n="unduh.wizard">Wizard</h2>
          <p class="text-[13px] text-[#6B6880]" data-i18n="unduh.wizard_desc">Installer GUI langkah demi langkah dengan pemilihan folder dan asosiasi file .eve.</p>
        </div>
      </div>
      <div class="mt-5 rounded-lg bg-[#15151E] p-4 font-mono text-[12.5px] leading-relaxed text-[#E6E6F2]">
        <div><span class="text-[#6B7280]">1.</span> unduh <span class="text-[#38BDF8]">Setup.exe</span></div>
        <div><span class="text-[#6B7280]">2.</span> klik dua kali, ikuti wizard</div>
        <div><span class="text-[#6B7280]">3.</span> selesai — PATH &amp; <span class="text-[#C9B8FF]">.eve</span> otomatis</div>
      </div>
      <a href={urlSetup} class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-[#1C1B22] px-5 py-3 text-sm font-semibold text-white hover:bg-[#2E2A3D] transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Unduh Setup.exe (1,8 MB)
      </a>
    </div>
  </section>

  <!-- Perintah -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 pb-6">
    <h2 class="text-lg font-bold text-[#1C1B22] mb-4" data-i18n="unduh.perintah">Perintah penting</h2>
    <div class="rounded-xl border border-[#E6E2F5] overflow-hidden font-mono text-[13px]">
      {[
        { k: 'unduh.cek', c: 'evernight --versi' },
        { k: 'unduh.update', c: 'update evernight system' },
        { k: 'unduh.copot', c: 'kill evernight system' },
        { k: 'unduh.jalankan', c: 'evernight halo.eve' },
      ].map((b, i) => (
        <div class:list={['flex items-center gap-4 px-4 py-2.5', i % 2 === 0 ? 'bg-white' : 'bg-[#FAFAF8]', i > 0 ? 'border-t border-[#EEECEF]' : '']}>
          <span class="w-40 shrink-0 text-[12.5px] text-[#6B6880] font-sans" data-i18n={b.k}>{b.k}</span>
          <code class="text-[#5B54B8]">{b.c}</code>
        </div>
      ))}
    </div>
  </section>

  <!-- SHA256 -->
  {barisSha.length > 0 && (
    <section class="max-w-5xl mx-auto px-5 md:px-8 py-8">
      <h2 class="text-lg font-bold text-[#1C1B22] mb-4" data-i18n="unduh.hash">SHA256</h2>
      <div class="rounded-xl border border-[#E6E2F5] overflow-x-auto">
        <table class="w-full text-[12.5px]" style="font-family: var(--font-mono);">
          <thead>
            <tr class="bg-[#F6F4FD] text-left text-[#1C1B22]">
              <th class="px-4 py-2.5 font-semibold">Hash</th>
              <th class="px-4 py-2.5 font-semibold">Berkas</th>
            </tr>
          </thead>
          <tbody>
            {barisSha.map((b, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-[#FAFAF8]'}>
                <td class="px-4 py-2 text-[#4A4756] break-all">{b.hash}</td>
                <td class="px-4 py-2 text-[#5B54B8] whitespace-nowrap">{b.nama}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-[13px] text-[#6B6880]" data-i18n="unduh.sumber">
        Sumber rilis juga tersedia di GitHub
        — <a class="text-[#5B54B8] underline" href="https://github.com/Evanight234/EvernightLang" target="_blank" rel="noopener">Evanight234/EvernightLang</a>
      </p>
    </section>
  )}
</Base>
