{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Evernight",
  "scopeName": "source.eve",
  "fileTypes": ["eve"],
  "patterns": [
    { "include": "#komentar" },
    { "include": "#string" },
    { "include": "#angka" },
    { "include": "#konstanta" },
    { "include": "#deklarasi_fungsi" },
    { "include": "#pemanggilan_fungsi" },
    { "include": "#keyword_kontrol" },
    { "include": "#keyword_deklarasi" },
    { "include": "#keyword_operator" },
    { "include": "#operator_simbol" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "komentar": {
      "patterns": [
        {
          "name": "comment.block.eve",
          "begin": "#\\[\\[",
          "end": "\\]\\]",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.eve" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.eve" } }
        },
        {
          "name": "comment.line.eve",
          "match": "#.*$"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.eve",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.eve" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.string.end.eve" } },
          "patterns": [
            { "name": "constant.character.escape.eve", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.eve",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.eve" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.string.end.eve" } },
          "patterns": [
            { "name": "constant.character.escape.eve", "match": "\\\\." }
          ]
        }
      ]
    },
    "angka": {
      "patterns": [
        {
          "name": "constant.numeric.hex.eve",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.eve",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.eve",
          "match": "\\b[0-9]+([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "konstanta": {
      "patterns": [
        {
          "name": "constant.language.boolean.eve",
          "match": "\\b(benar|salah)\\b"
        },
        {
          "name": "constant.language.null.eve",
          "match": "\\b(kosong)\\b"
        },
        {
          "name": "constant.language.wildcard.eve",
          "match": "\\b_\\b"
        }
      ]
    },
    "deklarasi_fungsi": {
      "comment": "fungsi namaFungsi(...) — highlight nama fungsi setelah keyword fungsi",
      "match": "\\b(fungsi)\\s+([a-zA-Z_\\u00C0-\\u024F][a-zA-Z0-9_\\u00C0-\\u024F]*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.eve" },
        "2": { "name": "entity.name.function.eve" }
      }
    },
    "pemanggilan_fungsi": {
      "comment": "namaFungsi( — highlight nama sebelum kurung buka",
      "match": "\\b([a-zA-Z_\\u00C0-\\u024F][a-zA-Z0-9_\\u00C0-\\u024F]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.eve" }
      }
    },
    "keyword_kontrol": {
      "name": "keyword.control.eve",
      "match": "\\b(jika|lainnya_jika|lainnya|selama|untuk|dari|sampai|dalam|berhenti|lanjut|kembali|cocok|kasus|bawaan|coba|tangkap|akhirnya|lempar|pastikan|impor|sebagai|hapus|cetak|baca)\\b"
    },
    "keyword_deklarasi": {
      "name": "keyword.declaration.eve",
      "match": "\\b(variabel|tetap|fungsi|kelas|objek)\\b"
    },
    "keyword_operator": {
      "name": "keyword.operator.word.eve",
      "match": "\\b(dan|atau|bukan|sama_dengan|lebih_dari|kurang_dari)\\b"
    },
    "operator_simbol": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.eve",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.eve",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.eve",
          "match": "(\\*\\*|[+\\-*/%])"
        },
        {
          "name": "keyword.operator.logical.eve",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.range.eve",
          "match": "\\.\\.\\.?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.block.eve",      "match": "[{}]" },
        { "name": "punctuation.definition.parameters.eve", "match": "[()]" },
        { "name": "punctuation.definition.array.eve",      "match": "[\\[\\]]" },
        { "name": "punctuation.separator.eve",             "match": "[,;]" },
        { "name": "punctuation.accessor.eve",              "match": "\\." },
        { "name": "punctuation.separator.key-value.eve",   "match": ":" }
      ]
    }
  }
}
